{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "includes": ["src/**/*.ts", "demo/**/*.ts", "landing/**/*.ts", "scripts/**/*.mjs", "test/**/*.mjs", "*.mjs"]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "linter": {
    "enabled": true,
    "rules": {
      "style": { "noNonNullAssertion": "off" }
    }
  },
  "overrides": [
    {
      "includes": ["test/**"],
      "linter": {
        "rules": {
          "correctness": { "noSelfAssign": "off" },
          "performance": { "useDomNodeTextContent": "off" },
          "suspicious": { "useIterableCallbackReturn": "off" }
        }
      }
    }
  ],
  "assist": { "enabled": false }
}
