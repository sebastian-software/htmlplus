{
  "name": "htmlplus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Native-feeling form controls and a live FormData playground.",
  "sideEffects": [
    "./lib/index.js",
    "./lib/elements/*.js",
    "./browser/**/*.js",
    "./src/index.ts",
    "./src/elements/*.ts",
    "./demo/*.ts",
    "./landing/*.ts"
  ],
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "node": "./lib/noop.js",
      "deno": "./lib/noop.js",
      "edge-light": "./lib/noop.js",
      "workerd": "./lib/noop.js",
      "worker": "./lib/noop.js",
      "default": "./lib/index.js"
    },
    "./react": {
      "types": "./lib/react.d.ts",
      "default": "./lib/noop.js"
    },
    "./native.css": "./styles/native.css",
    "./themes.css": "./styles/themes.css",
    "./shadcn.css": "./styles/shadcn.css",
    "./package.json": "./package.json",
    "./custom-elements.json": "./custom-elements.json",
    "./browser/*": "./browser/*",
    "./*": {
      "types": "./lib/elements/*.d.ts",
      "node": "./lib/noop.js",
      "deno": "./lib/noop.js",
      "edge-light": "./lib/noop.js",
      "workerd": "./lib/noop.js",
      "worker": "./lib/noop.js",
      "default": "./lib/elements/*.js"
    }
  },
  "files": [
    "lib",
    "browser",
    "styles",
    "custom-elements.json",
    "THIRD_PARTY_NOTICES.txt"
  ],
  "license": "Apache-2.0",
  "customElements": "custom-elements.json",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "build:demo": "node scripts/build-demo.mjs",
    "build:package": "node scripts/build-package.mjs",
    "prepack": "node scripts/build-package.mjs",
    "test:consumer": "node scripts/check-consumer.mjs",
    "preview": "node scripts/serve.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check",
    "format": "biome check --write",
    "test": "node scripts/check.mjs",
    "test:unit": "node scripts/build.mjs && node --test \"test/*.test.mjs\"",
    "test:browser": "node scripts/build-demo.mjs && node scripts/check-consumer.mjs && playwright test",
    "check:size": "node scripts/sizes.mjs --check",
    "docs:sizes": "node scripts/sizes.mjs",
    "check:notices": "node scripts/check-notices.mjs",
    "docs:api": "node scripts/build.mjs && node scripts/generate-api.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/react": "19.3.0",
    "axe-core": "4.14.0",
    "esbuild": "0.25.12",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@internationalized/date": "3.12.4",
    "@internationalized/number": "3.6.9",
    "@zag-js/accordion": "1.47.0",
    "@zag-js/checkbox": "1.47.0",
    "@zag-js/combobox": "1.47.0",
    "@zag-js/date-picker": "1.47.0",
    "@zag-js/number-input": "1.47.0",
    "@zag-js/password-input": "1.47.0",
    "@zag-js/radio-group": "1.47.0",
    "@zag-js/rating-group": "1.47.0",
    "@zag-js/select": "1.47.0",
    "@zag-js/slider": "1.47.0",
    "@zag-js/tabs": "1.47.0",
    "@zag-js/toggle": "1.47.0",
    "@zag-js/toggle-group": "1.47.0",
    "@zag-js/vanilla": "1.47.0"
  }
}
